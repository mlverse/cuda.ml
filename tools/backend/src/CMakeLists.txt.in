cmake_minimum_required(VERSION 3.21.1 FATAL_ERROR)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CUDA_STANDARD 17)
set(CMAKE_CUDA_STANDARD_REQUIRED ON)
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wall")

project(cuda.ml LANGUAGES CUDA CXX)

if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU" OR CMAKE_CXX_COMPILER_VERSION VERSION_LESS 14)
    message(FATAL_ERROR "The pinned nvForest 26.06 binary requires GCC 14 or newer.")
endif()

if(DEFINED CUML_INCLUDE_DIR)
    # CMAKE_CUDA_TOOLKIT_INCLUDE_DIRECTORIES is needed so that cuda_runtime.h is found
    # CUML_INCLUDE_DIR is needed so that kmeans/kmeans_c.h is found
    set(CUML4R_INCLUDE_DIRS ${CUML_INCLUDE_DIR} ${CMAKE_CUDA_TOOLKIT_INCLUDE_DIRECTORIES})
    if(EXISTS "${CUML_INCLUDE_DIR}/rapids")
      # RAPIDS pip wheels may ship a CCCL copy that matches the RAPIDS shared
      # libraries under include/rapids, plus a newer top-level CCCL copy.
      # Prefer the ABI-compatible copy for cuda/cub/thrust/nv headers.
      include_directories(BEFORE SYSTEM ${CUML_INCLUDE_DIR}/rapids)
    endif()
else()
    message(FATAL_ERROR "CUML_INCLUDE_DIR not specified.")
endif(DEFINED CUML_INCLUDE_DIR)
if(DEFINED CUML_LIB_DIR)
    find_library(
      CUML_LIBRARY
      NAMES cuml
      PATHS ${CUML_LIB_DIR}
      NO_DEFAULT_PATH
    )
    if(NOT CUML_LIBRARY)
      message(FATAL_ERROR "libcuml.so was not found in ${CUML_LIB_DIR}.")
    endif()
    find_library(
      NVFOREST_LIBRARY
      NAMES nvforest++
      PATHS ${CUML_LIB_DIR}
      NO_DEFAULT_PATH
    )
    if(NOT NVFOREST_LIBRARY)
      message(FATAL_ERROR "libnvforest++.so was not found in ${CUML_LIB_DIR}.")
    endif()
    set(TREELITE_STATIC_LIBRARY "${CUML_LIB_DIR}/libtreelite_static.a")
    if(NOT EXISTS "${TREELITE_STATIC_LIBRARY}")
      message(FATAL_ERROR "libtreelite_static.a was not found in ${CUML_LIB_DIR}.")
    endif()
else()
    message(FATAL_ERROR "CUML_LIB_DIR not specified.")
endif(DEFINED CUML_LIB_DIR)

include_directories(@R_INCLUDE_DIR@)
include_directories(@RCPP_INCLUDE_DIR@)

foreach(CUML4R_REQUIRED_HEADER
    cuml/version_config.hpp
    nvforest/forest_model.hpp
    nvforest/treelite_importer.hpp
    nvforest/version_config.hpp
    treelite/c_api.h
    treelite/tree.h
    treelite/version.h)
  if(NOT EXISTS "${CUML_INCLUDE_DIR}/${CUML4R_REQUIRED_HEADER}")
    message(FATAL_ERROR "Required header ${CUML4R_REQUIRED_HEADER} was not found in ${CUML_INCLUDE_DIR}.")
  endif()
endforeach()

add_library(
  cuda.ml
  SHARED
  # utils
  cuda_utils.cu
  cuml_utils.cpp
  handle_utils.cu
  nvforest.cu
  stream_allocator.cu
  # models & algorithms
  agglomerative_clustering.cpp
  agglomerative_clustering.cu
  cd.cpp
  cd.cu
  cd_fit_impl.cu
  dbscan.cpp
  dbscan.cu
  nvforest.cpp
  kmeans.cpp
  kmeans.cu
  knn.cpp
  knn.cu
  lm.cu
  lm_predict.cpp
  lm_predict.cu
  native_symbols.cpp
  ols.cpp
  ols.cu
  ols_fit_impl.cu
  pca.cpp
  pca.cu
  qn.cpp
  qn.cu
  random_forest_classifier.cpp
  random_forest_classifier.cu
  random_forest_regressor.cpp
  random_forest_regressor.cu
  ridge.cpp
  ridge.cu
  ridge_fit_impl.cu
  sgd.cpp
  sgd.cu
  sgd_fit_impl.cu
  svm_classifier.cpp
  svm_classifier.cu
  svm_regressor.cpp
  svm_regressor.cu
  svm_serde.cu
  tsne.cpp
  tsne.cu
  tsvd.cpp
  tsvd.cu
  umap.cpp
  umap.cu
  # Rcpp exports
  RcppExports.cpp
)

# nvForest's importer instantiates Treelite templates in this translation unit.
set_source_files_properties(
  nvforest.cu
  PROPERTIES COMPILE_OPTIONS "-Xcompiler=-fvisibility=hidden"
)

# Need to set linker language to CUDA to link the CUDA Runtime
set_target_properties(
  cuda.ml
  PROPERTIES
  LINKER_LANGUAGE "CUDA"
  PREFIX ""
  BUILD_WITH_INSTALL_RPATH TRUE
  INSTALL_RPATH "$ORIGIN"
  INSTALL_RPATH_USE_LINK_PATH FALSE
)
target_compile_definitions(
  cuda.ml
  PRIVATE
  NDEBUG
  CUML_LOG_ACTIVE_LEVEL=RAPIDS_LOGGER_LOG_LEVEL_OFF
  NVFOREST_ENABLE_GPU
  NVFOREST_LOG_ACTIVE_LEVEL=RAPIDS_LOGGER_LOG_LEVEL_OFF
  RAFT_LOG_ACTIVE_LEVEL=RAPIDS_LOGGER_LOG_LEVEL_OFF
  RMM_LOG_ACTIVE_LEVEL=RAPIDS_LOGGER_LOG_LEVEL_OFF
)

# Treelite is a private implementation detail. Its C API explicitly requests
# default visibility, so also localize every symbol supplied by its archive.
target_link_options(
  cuda.ml
  PRIVATE
  "LINKER:--exclude-libs,libtreelite_static.a"
)

target_link_libraries(
  cuda.ml
  PRIVATE
  ${CUML_LIBRARY}
  ${NVFOREST_LIBRARY}
  ${TREELITE_STATIC_LIBRARY}
  cublas
  cusolver
  cudart
  cusparse
)

target_include_directories(cuda.ml SYSTEM PRIVATE ${CUML4R_INCLUDE_DIRS})
